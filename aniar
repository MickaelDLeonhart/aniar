#!/usr/bin/env bash
# aniar - Arabic Anime Streaming Tool
# Created by Mickael D Leonhart
# GitHub: https://github.com/MickaelDLeonhart/aniar
# ==================== CONFIGURATION ====================
VERSION="1.0.1"
AUTHOR="Mickael D Leonhart"
GITHUB_URL="https://github.com/MickaelDLeonhart/aniar"
ANIME4UP_BASE="https://w1.anime4up.rest"
PREFERRED_SOURCES=("videa.hu" "drive.google.com" "ok.ru" "solidfiles.com" "mp4upload.com" "4shared.com")
DEFAULT_PLAYER="mpv"
USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"
DEBUG_MODE=0

# Config directory
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/aniar"
CONFIG_FILE="$CONFIG_DIR/config"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/aniar"
HISTORY_FILE="$CONFIG_DIR/history"

# ASCII Art
show_banner() {
    cat << "EOF"
                                                                  _______  _              _______ 
                                                                 (  ___  )( \   |\     /|(  ___  )
                                                                 | (   ) || (   ( \   / )| (   ) |
                                                                 | (___) || |    \ (_) / | (___) |
                                                                 |  ___  || |     \   /  |  ___  |
                                                                 | (   ) || |      ) (   | (   ) |
                                                                 | )   ( || (____/\| |   | )   ( |
                                                                 |/     \|(_______/\_/   |/     \|
                                 
                                                                    Arabic Anime Streaming Tool
EOF
    echo -e "v$VERSION | By $AUTHOR\n"
}

# ==================== LOGGING FUNCTIONS ====================

log() { printf "\033[1;34m>>\033[0m %s\n" "$*" >&2; }
warn() { printf "\033[1;33m!\033[0m %s\n" "$*" >&2; }
die() { printf "\033[1;31mERROR:\033[0m %s\n" "$*" >&2; exit 1; }
debug() { 
    [ "$DEBUG_MODE" -eq 1 ] && printf "\033[1;36mDEBUG:\033[0m %s\n" "$*" >&2
    return 0
}

# ==================== UTILITY FUNCTIONS ====================

setup_directories() {
    mkdir -p "$CONFIG_DIR" "$CACHE_DIR"
    [ ! -f "$CONFIG_FILE" ] && create_default_config
    [ ! -f "$HISTORY_FILE" ] && touch "$HISTORY_FILE"
}

create_default_config() {
    cat > "$CONFIG_FILE" << 'EOF'
# aniar Configuration File

# Preferred video sources (in order of preference)
# PREFERRED_SOURCES=("videa.hu" "drive.google.com" "ok.ru" "solidfiles.com")

# Video player and options
# DEFAULT_PLAYER="mpv"
# MPV_OPTIONS="--force-window=yes --keep-open=yes"

# Video quality preference (best, worst, 720p, 480p, etc)
# QUALITY="best"

# Subtitle language preference (ar, en, none)
# SUBTITLE_LANG="ar"

# Auto-play next episode
# AUTO_NEXT=false

# Default anime directory for downloads
# DOWNLOAD_DIR="$HOME/Anime"

# Enable/disable watch history
# TRACK_HISTORY=true
EOF
    log "Created default config at $CONFIG_FILE"
}

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
    fi
}

# Cache functions
cache_get() {
    local key="$1"
    local cache_file="$CACHE_DIR/$(echo -n "$key" | md5sum | cut -d' ' -f1)"
    [ -f "$cache_file" ] && cat "$cache_file"
}

cache_set() {
    local key="$1"
    local value="$2"
    local cache_file="$CACHE_DIR/$(echo -n "$key" | md5sum | cut -d' ' -f1)"
    echo "$value" > "$cache_file"
}

# History tracking
add_to_history() {
    [ "${TRACK_HISTORY:-true}" = "false" ] && return
    
    local series="$1"
    local episode="$2"
    local title="$3"
    local timestamp=$(date +%s)
    
    echo "$series|$episode|$title|$timestamp" >> "$HISTORY_FILE"
    tail -n 50 "$HISTORY_FILE" > "$HISTORY_FILE.tmp" && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}

get_last_watched() {
    local series="$1"
    grep "^$series|" "$HISTORY_FILE" 2>/dev/null | tail -1 | cut -d'|' -f2
}

show_history() {
    if [ -s "$HISTORY_FILE" ]; then
        log "📺 Watch History:"
        echo "┌────────────────────────────────────────────────────┐"
        while IFS='|' read -r series episode title timestamp; do
            local date_str=$(date -d "@$timestamp" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "N/A")
            printf "│ %-40s Episode %-3s (%s) │\n" "$title" "$episode" "$date_str"
        done < <(tac "$HISTORY_FILE" 2>/dev/null | head -10)
        echo "└────────────────────────────────────────────────────┘"
    else
        log "No watch history yet"
    fi
}

# ==================== CORE FUNCTIONS ====================

normalize_url() {
    local url="$1"
    [[ "$url" == //* ]] && echo "https:$url" || echo "$url"
}

extract_video_sources() {
    local episode_url="$1"
    
    local cache_key="sources_$(echo -n "$episode_url" | md5sum | cut -d' ' -f1)"
    local cached=$(cache_get "$cache_key")
    [ -n "$cached" ] && { echo "$cached"; return; }
    
    debug "Extracting sources from: $episode_url"
    
    local sources=$(curl -s -L -A "$USER_AGENT" "$episode_url" | \
        grep -oP 'data-src="\K[^"]+' | \
        while read -r url; do
            normalize_url "$url"
        done | \
        sort -u)
    
    cache_set "$cache_key" "$sources"
    echo "$sources"
}

get_mp4upload_video() {
    local embed_url="$1"
    
    debug "Processing mp4upload.com embed"
    
    local embed_html=$(curl -s -L -A "$USER_AGENT" "$embed_url")
    local video_url=""
    
    video_url=$(echo "$embed_html" | grep -oP 'iframe[^>]+src="\K[^"]+' | head -1)
    [ -z "$video_url" ] && video_url=$(echo "$embed_html" | grep -oP 'file\s*:\s*["'\'']\K[^"'\'']+' | \
        grep -i '\.mp4\|\.m3u8\|\.mpd' | head -1)
    [ -z "$video_url" ] && video_url=$(echo "$embed_html" | grep -oP 'https?://[^"\s<>]+\.(mp4|m3u8|mpd|mkv|webm)[^"\s<>]*' | head -1)
    [ -z "$video_url" ] && video_url=$(echo "$embed_html" | grep -oP '"sources"\s*:\s*\[\s*{\s*"file"\s*:\s*"\K[^"]+' | head -1)
    
    if [ -z "$video_url" ]; then
        local video_id=$(echo "$embed_html" | grep -oP 'file\s*=\s*["'\'']\K[^"'\'']+' | head -1)
        [ -n "$video_id" ] && video_url="https://www.mp4upload.com/$video_id"
    fi
    
    if [ -n "$video_url" ]; then
        [[ "$video_url" != http* ]] && video_url="https:$video_url"
        echo "$video_url"
        return 0
    fi
    
    yt-dlp -g "$embed_url" 2>/dev/null | head -1
}

get_playable_url() {
    local source_url="$1"
    
    debug "Processing: $(basename "$source_url")"
    
    if [[ "$source_url" == *"mp4upload.com"* ]]; then
        get_mp4upload_video "$source_url"
        return $?
    fi
    
    local video_url=$(yt-dlp -g "$source_url" 2>/dev/null)
    [ -n "$video_url" ] && echo "$video_url" && return 0
    
    case "$source_url" in
        *"drive.google.com"*)
            local drive_id=$(echo "$source_url" | grep -oP '/d/([^/]+)' | cut -d/ -f3)
            [ -n "$drive_id" ] && echo "https://drive.google.com/uc?id=$drive_id&export=download" && return 0
            ;;
    esac
    
    return 1
}

select_best_source() {
    local episode_url="$1"
    
    local sources=$(extract_video_sources "$episode_url")
    [ -z "$sources" ] && die "No video sources found"
    
    local source_count=$(echo "$sources" | wc -l)
    log "📡 Found $source_count source$( [ $source_count -ne 1 ] && echo s )"
    
    for preferred in "${PREFERRED_SOURCES[@]}"; do
        local source=$(echo "$sources" | grep -i "$preferred" | head -1)
        [ -z "$source" ] && continue
        
        log "Trying: $preferred"
        local video_url=$(get_playable_url "$source")
        
        if [ -n "$video_url" ] && [[ "$video_url" != *".css" ]] && [[ "$video_url" != *".js" ]]; then
            log "✅ Source found!"
            echo "$video_url"
            return 0
        fi
    done
    
    warn "🔄 Trying fallback sources..."
    while read -r source; do
        local video_url=$(get_playable_url "$source")
        if [ -n "$video_url" ] && [[ "$video_url" != *".css" ]] && [[ "$video_url" != *".js" ]]; then
            warn "✅ Fallback works!"
            echo "$video_url"
            return 0
        fi
    done <<< "$sources"
    
    warn "🌐 Trying direct episode page..."
    local video_url=$(yt-dlp -g "$episode_url" 2>/dev/null | head -1)
    [ -n "$video_url" ] && warn "✅ Direct link works!" && echo "$video_url" && return 0
    
    die "❌ No playable sources found"
}

# ==================== ANIME4UP FUNCTIONS ====================

extract_title_from_url() {
    local url="$1"
    echo "$url" | sed '
        s|.*/anime/||;
        s|.*/episode/||;
        s/%[0-9A-Fa-f][0-9A-Fa-f]//g;
        s/-/ /g;
        s|/||g;
        s/^ //; s/ $//;
        s/  */ /g'
}

search_anime4up_fast() {
    local query="$1"
    log "🔍 Searching Anime4Up: $query"

    local cache_key="search_a4up_$(echo -n "$query" | md5sum | cut -d' ' -f1)"
    local cached=$(cache_get "$cache_key")
    [ -n "$cached" ] && { echo "$cached"; return; }

    local encoded_query=$(printf "%s" "$query" | sed 's/ /+/g')
    local search_url="${ANIME4UP_BASE}/?search_param=animes&s=${encoded_query}"

    local html=$(curl -s -L -A "$USER_AGENT" "$search_url")

    # Real HTML: <h3><a href="https://w1.anime4up.rest/anime/SLUG/">Title</a></h3>
    # Extract url\ttitle pairs from these h3 lines in one pass
    local results=$(echo "$html" | grep -oP '<h3><a href="\Khttps://w1\.anime4up\.rest/anime/[^"]+(?="[^>]*>[^<]+</a></h3>)' | \
        while read -r url; do
            local title=$(echo "$html" | grep -oP "href=\"${url//./\\.}\"[^>]*>\\K[^<]+")
            [ -n "$title" ] && echo -e "${url}\t${title}"
        done)

    # Reliable fallback: single grep that captures both url and title from the same h3 line
    if [ -z "$results" ]; then
        results=$(echo "$html" | \
            grep -oP '<h3><a href="(https://w1\.anime4up\.rest/anime/[^"]+)"[^>]*>([^<]+)</a></h3>' | \
            sed 's|<h3><a href="\([^"]*\)"[^>]*>\([^<]*\)</a></h3>|\1\t\2|')
    fi

    cache_set "$cache_key" "$results"
    echo "$results"
}

get_episodes_from_anime4up() {
    local series_url="$1"

    log "📺 Loading episodes from Anime4Up..."

    local cache_key="episodes_a4up_$(echo -n "$series_url" | md5sum | cut -d' ' -f1)"
    local cached=$(cache_get "$cache_key")
    [ -n "$cached" ] && { echo "$cached"; return; }

    local html=$(curl -s -L -A "$USER_AGENT" "$series_url")

    # Real structure: <a href="https://w1.anime4up.rest/episode/SLUG-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-NUMBER/">
    # URL-encoded الحلقة = %d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9 (lowercase) or %D8%A7... (uppercase)
    local episodes=$(echo "$html" | \
        grep -oiP 'href="\Khttps://w1\.anime4up\.rest/episode/[^"]+' | \
        sort -u | \
        while read -r url; do
            # Decode %d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9 -> الحلقة then grab the trailing number
            local ep_num=$(echo "$url" | grep -oiP '(?<=%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-)\d+' | head -1)
            # Also try after decoded form if curl had already decoded
            [ -z "$ep_num" ] && ep_num=$(echo "$url" | grep -oP '(?<=الحلقة-)\d+' | head -1)
            # Fallback: last number in the slug
            [ -z "$ep_num" ] && ep_num=$(echo "$url" | grep -oP '\d+(?=[^0-9/]*/?$)' | head -1)
            [ -z "$ep_num" ] && ep_num="?"
            echo -e "${ep_num}\tالحلقة ${ep_num}\t${url}"
        done | sort -t$'\t' -k1,1V)

    cache_set "$cache_key" "$episodes"
    echo "$episodes"
}

extract_embed_video_url() {
    local embed_url="$1"
    local referer="${2:-https://w1.anime4up.rest/}"

    # Try yt-dlp first (fast path)
    local video_url=$(yt-dlp --no-warnings -g "$embed_url" 2>/dev/null | head -1)
    [ -n "$video_url" ] && echo "$video_url" && return 0

    # Fetch the embed page HTML and scrape direct video URL
    local html=$(curl -s -L -A "$USER_AGENT" -e "$referer" "$embed_url")

    # Match direct mp4/m3u8/mpd URLs
    video_url=$(echo "$html" | grep -oP 'https?://[^\s"'\''<>]+\.(mp4|m3u8|mpd)[^\s"'\''<>]*' | head -1)
    [ -n "$video_url" ] && echo "$video_url" && return 0

    # Match "file": "URL" or file: "URL" patterns (jwplayer / plyr style)
    video_url=$(echo "$html" | grep -oP '"file"\s*:\s*"\K[^"]+' | grep -i 'mp4\|m3u8\|mpd' | head -1)
    [ -n "$video_url" ] && echo "$video_url" && return 0

    # Match sources:[{file:"URL"}] without quotes around key
    video_url=$(echo "$html" | grep -oP 'file\s*:\s*"\K[^"]+' | grep -i 'mp4\|m3u8\|mpd' | head -1)
    [ -n "$video_url" ] && echo "$video_url" && return 0

    return 1
}

extract_anime4up_video() {
    local episode_url="$1"

    debug "Extracting Anime4Up video from: $episode_url"

    local html=$(curl -s -L -A "$USER_AGENT" "$episode_url")

    # Sources are in: <li data-watch="EMBED_URL" ...>
    local embeds=$(echo "$html" | grep -oP 'data-watch="\K[^"]+')
    [ -z "$embeds" ] && { warn "No data-watch sources found on page"; return 1; }

    local count=$(echo "$embeds" | wc -l)
    log "📡 Found $count embed source(s) on Anime4Up"

    # Skip these entirely - broken or unsupported
    local skip_list=("mega.nz" "ok.ru" "solidfiles" "uptostream" "vidbam" "vadbam" "dood" "dsvplay" "myvidplay")

    while read -r embed; do
        local skip=0
        for s in "${skip_list[@]}"; do
            [[ "$embed" == *"$s"* ]] && skip=1 && break
        done
        [ "$skip" -eq 1 ] && debug "Skipping: $embed" && continue

        local embed_name=$(echo "$embed" | grep -oP 'https?://\K[^/]+' | sed 's/^www\.//')
        log "🔗 Trying: $embed_name"
        local video_url=$(extract_embed_video_url "$embed" "$episode_url")
        if [ -n "$video_url" ]; then
            log "✅ Got stream!"
            echo "$video_url"
            echo "REFERER:$embed"
            return 0
        fi
        warn "⚠️  No stream from: $embed"
    done <<< "$embeds"

    warn "❌ No playable source found on Anime4Up"
    return 1
}

# ==================== SOURCE SELECTION WITH FALLBACK ====================

search_with_fallback() {
    local query="$1"

    local results=$(search_anime4up_fast "$query" 2>/dev/null)
    if [ -n "$results" ]; then
        echo "anime4up"
        echo "$results"
        return 0
    fi

    return 1
}

# ==================== PLAYBACK FUNCTIONS ====================

play_episode() {
    local episode_url="$1"
    local title="$2"
    local episode_num="$3"
    
    local clean_title=$(echo "$title" | sed 's/%[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]*//g; s/-/ /g; s|/||g; s/^ //; s/ $//; s/  */ /g')
    [ -z "$clean_title" ] && clean_title="Anime Episode"
    
    log "🎬 Playing: $clean_title $( [ -n "$episode_num" ] && echo "- Episode $episode_num" )"

    local video_url=""

    local embed_referer=""
    local raw_output
    raw_output=$(extract_anime4up_video "$episode_url")
    video_url=$(echo "$raw_output" | grep -v '^REFERER:' | head -1)
    embed_referer=$(echo "$raw_output" | grep '^REFERER:' | head -1 | cut -d: -f2-)
    [ -z "$video_url" ] && die "Failed to get video URL"
    
    add_to_history "$clean_title" "$episode_num" "$clean_title Episode $episode_num"
    
    log "🚀 Launching player..."
    
    local mpv_opts=("--force-media-title=$clean_title")
    # Pass referer + user-agent headers so CDN accepts the request
    if [ -n "$embed_referer" ]; then
        mpv_opts+=("--referrer=$embed_referer")
        mpv_opts+=("--user-agent=$USER_AGENT")
    fi
    [ -n "$MPV_OPTIONS" ] && mpv_opts+=($MPV_OPTIONS)
    
    if ! $DEFAULT_PLAYER "${mpv_opts[@]}" "$video_url" 2>/dev/null; then
        warn "🔄 Trying with different options..."
        $DEFAULT_PLAYER "${mpv_opts[@]}" --no-cache --cache=no "$video_url" 2>/dev/null || true
    fi
}

# ==================== USER INTERFACE ====================

interactive_select() {
    local query="$1"

    # --- Get search results with fallback ---
    local raw_output
    raw_output=$(search_with_fallback "$query") || die "No results found on any source"

    local active_source=$(echo "$raw_output" | head -1)
    local series_results=$(echo "$raw_output" | tail -n +2)

    [ -z "$series_results" ] && die "No results found"

    log "📡 Source: $active_source"

    local selected_series
    if command -v fzf >/dev/null; then
        selected_series=$(printf "%b" "$series_results" | fzf --reverse --with-nth=2.. --prompt="🎌 Select anime: " | cut -f1)
    else
        log "Results:"
        printf "%b" "$series_results" | cut -f2 | cat -n
        printf "Enter number: "
        read -r choice
        selected_series=$(printf "%b" "$series_results" | sed -n "${choice}p" | cut -f1)
    fi
    [ -z "$selected_series" ] && die "No selection"

    local episodes=$(get_episodes_from_anime4up "$selected_series")
    [ -z "$episodes" ] && die "No episodes found"

    local series_title=$(extract_title_from_url "$selected_series")
    local last_ep=$(get_last_watched "$series_title")
    [ -n "$last_ep" ] && log "📝 Last watched: Episode $last_ep"

    local selected_episode
    if command -v fzf >/dev/null; then
        selected_episode=$(printf "%s\n" "$episodes" | fzf --reverse --with-nth=1,2 --prompt="🎬 Select episode: " --header="Last: Episode $last_ep")
    else
        printf "%s\n" "$episodes" | cut -f1,2 | cat -n
        printf "Enter episode number: "
        read -r choice
        selected_episode=$(printf "%s\n" "$episodes" | sed -n "${choice}p")
    fi

    local ep_num=$(echo "$selected_episode" | cut -f1)
    local ep_url=$(echo "$selected_episode" | cut -f3)

    echo "$ep_url"
    echo "$ep_num"
    echo "$active_source"
}

# ==================== COMMAND FUNCTIONS ====================

show_help() {
    show_banner
    cat << EOF
Usage:
  aniar [OPTION]... [QUERY]

Options:
  QUERY                   Search and play anime via Anime4Up
  continue SERIES         Continue watching from last episode
  search QUERY            Search without playing
  direct URL [TITLE]      Play direct episode URL
  history                 Show watch history
  config                  Open configuration file
  update                  Check for updates
  clean                   Clear cache
  help                    Show this help

Source: Anime4Up (${ANIME4UP_BASE})

Examples:
  aniar "ناروتو"          # Search and play Naruto
  aniar continue "ون بيس" # Continue One Piece
  aniar direct "URL"      # Play direct link
  aniar history           # Show watch history

Configuration: $CONFIG_FILE
GitHub: $GITHUB_URL
EOF
}

check_dependencies() {
    local missing=()
    
    command -v curl >/dev/null || missing+=("curl")
    command -v yt-dlp >/dev/null || missing+=("yt-dlp")
    command -v mpv >/dev/null || missing+=("mpv")
    
    if [ ${#missing[@]} -gt 0 ]; then
        die "Missing dependencies: ${missing[*]}"
    fi
}

check_update() {
    log "🔍 Checking for updates..."
    local latest
    latest=$(curl -s "https://api.github.com/repos/MickaelDLeonhart/aniar/releases/latest" 2>/dev/null | \
        grep -oP '"tag_name": "\K[^"]+') || latest="$VERSION"
    
    if [ "$latest" != "$VERSION" ] && [ "$latest" != "v$VERSION" ]; then
        warn "📦 Update available! v$VERSION → v$latest"
        warn "Run: curl -sL $GITHUB_URL/raw/main/install.sh | bash"
    else
        log "✅ You have the latest version (v$VERSION)"
    fi
}

clean_cache() {
    if [ -d "$CACHE_DIR" ]; then
        rm -rf "$CACHE_DIR"/*
        log "🧹 Cache cleared"
    else
        log "No cache to clear"
    fi
}

# ==================== MAIN ====================

main() {
    setup_directories
    load_config
    check_dependencies
    
    local query="$*"
    
    if [ -z "$query" ]; then
        show_banner
        printf "Enter anime name: "
        read -r query
    fi
    
    [ -z "$query" ] && die "No search query"
    
    local selection
    selection=$(interactive_select "$query")
    local episode_url=$(echo "$selection" | sed -n '1p')
    local episode_num=$(echo "$selection" | sed -n '2p')
    local active_source=$(echo "$selection" | sed -n '3p')
    
    [ -z "$episode_url" ] && die "No episode selected"
    
    local title=$(extract_title_from_url "$episode_url")
    play_episode "$episode_url" "$title" "$episode_num"
}

# ==================== COMMAND DISPATCH ====================

case "${1:-}" in
    help|--help|-h)
        show_help
        ;;
    version|--version|-v)
        show_banner
        ;;
    search)
        [ -z "$2" ] && die "Usage: $0 search QUERY"
        search_with_fallback "${*:2}" | tail -n +2 | cat -n
        ;;
    direct)
        [ -z "$2" ] && die "Usage: $0 direct URL [TITLE]"
        play_episode "$2" "${3:-Direct Stream}" "${4:-}"
        ;;
    history)
        show_history
        ;;
    config)
        ${EDITOR:-vi} "$CONFIG_FILE"
        ;;
    update)
        check_update
        ;;
    continue)
        [ -z "$2" ] && die "Usage: $0 continue SERIES_NAME"
        main "${*:2}"
        ;;
    clean)
        clean_cache
        ;;
    debug)
        DEBUG_MODE=1
        shift
        main "$@"
        ;;
    *)
        main "$@"
        ;;
esac
